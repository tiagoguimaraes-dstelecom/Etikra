<Window x:Class="Etikra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etikra" Height="860" Width="1380" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#F3F4F7"
        FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E5EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="E" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Etikra" FontFamily="Segoe UI Semibold" FontSize="19" />
                        <TextBlock Text="Open label studio" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="New" Margin="0,0,7,0" Click="New_Click" />
                    <Button Content="Open" Margin="0,0,7,0" Click="Open_Click" />
                    <Button x:Name="SaveButton" Content="Save" Margin="0,0,7,0" Click="Save_Click" IsEnabled="False" />
                    <Button x:Name="ExportButton" Content="Export PNG" Margin="0,0,7,0" Click="Export_Click" IsEnabled="False" />
                    <Button x:Name="MockPrintButton" Content="Save mock PNG" Click="MockPrint_Click" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DuplicateButton" Content="Duplicate" Margin="0,0,8,0" Click="Duplicate_Click" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFAFC" BorderBrush="#E2E5EB" BorderThickness="0,0,1,0" Padding="16,18">
                <Grid>
                    <Border x:Name="NoDocumentToolsHint" Background="#F1F2F5" CornerRadius="9" Padding="12" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="NO LABEL" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Create a label from installed media, choose a custom size, or open a saved label."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="EditorToolsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ADD TO LABEL" Style="{StaticResource SectionTitle}" />
                            <Button Style="{StaticResource ToolButton}" Content="T   Text" Tag="Text" Click="AddElement_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="▥   Code 128 barcode" Tag="Barcode" Click="AddElement_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="□   Rectangle" Tag="Rectangle" Click="AddElement_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="—   Line" Tag="Line" Click="AddElement_Click" />
                            <Button Style="{StaticResource ToolButton}" Content="▧   Image" Tag="Image" Click="AddElement_Click" />
                            <Separator Margin="0,10,0,14" Background="#E2E5EB" />
                            <TextBlock Text="LABEL INFORMATION" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DocumentNameBox" LostFocus="DocumentField_LostFocus" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Length (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DocumentWidthBox" LostFocus="DocumentField_LostFocus" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Tape width (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DocumentHeightBox" LostFocus="DocumentField_LostFocus" /></StackPanel>
                            </Grid>
                            <TextBlock x:Name="DocumentMediaBindingText" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#ECEEF2">
                <ScrollViewer x:Name="CanvasScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="48">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="LabelSurface" Background="White" BorderBrush="#CDD1D9" BorderThickness="1" Effect="{DynamicResource LabelShadow}">
                            <Canvas x:Name="DesignCanvas" Background="White" ClipToBounds="True" MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown" />
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Border x:Name="EmptyWorkspacePanel" Width="480" Padding="30" CornerRadius="14" Background="White"
                        BorderBrush="#DDE1E8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource LabelShadow}">
                    <StackPanel>
                        <TextBlock Text="Create your first label" FontFamily="Segoe UI Semibold" FontSize="23" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyWorkspaceMessage" Text="No label is open. Connect a label maker, use a custom size, or open an existing file."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" />
                        <Button x:Name="EmptyUseMediaButton" Content="Use installed media" Style="{StaticResource PrimaryButton}"
                                Click="UseLoadedMedia_Click" IsEnabled="False" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Label length (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NewLabelLengthBox" Text="40" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Tape width (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NewLabelWidthBox" Text="15" /></StackPanel>
                        </Grid>
                        <Button Content="Create custom-size label" Margin="0,10,0,0" Click="CreateCustomLabel_Click" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Content="Open saved label" Click="Open_Click" />
                            <Button Grid.Column="2" Content="Find label maker" Click="FindPrinter_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#FAFAFC" BorderBrush="#E2E5EB" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="LABEL MAKER" Style="{StaticResource SectionTitle}" />
                        <Border Background="White" BorderBrush="#E0E3EA" BorderThickness="1" CornerRadius="9" Padding="11">
                            <StackPanel>
                                <TextBlock x:Name="PrinterConnectionText" Text="Disconnected" FontFamily="Segoe UI Semibold" FontSize="14" />
                                <TextBlock x:Name="PrinterIdentityText" Text="No label maker selected." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock x:Name="PrinterHealthText" Text="Connect a printer to read hardware health." TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="FindPrinterButton" Content="Find / change" Margin="0,0,7,7" Click="FindPrinter_Click" />
                                    <Button x:Name="RetryPrinterButton" Content="Retry" Margin="0,0,7,7" Click="RetryPrinter_Click" Visibility="Collapsed" />
                                    <Button x:Name="DisconnectPrinterButton" Content="Disconnect" Margin="0,0,7,7" Click="DisconnectPrinter_Click" Visibility="Collapsed" />
                                    <Button x:Name="ForgetPrinterButton" Content="Forget" Margin="0,0,7,7" Click="ForgetPrinter_Click" Visibility="Collapsed" />
                                </WrapPanel>
                                <StackPanel x:Name="PrinterCandidatesPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="PrinterScanStatusText" Text="Searching…" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <ListBox x:Name="PrinterCandidatesList" DisplayMemberPath="DisplayName" MinHeight="54" MaxHeight="130" Margin="0,6,0,0" />
                                    <Button x:Name="ConnectSelectedPrinterButton" Content="Connect selected" Style="{StaticResource PrimaryButton}" Margin="0,7,0,0" Click="ConnectSelectedPrinter_Click" />
                                </StackPanel>
                                <Expander Header="Diagnostics" Margin="0,5,0,0">
                                    <TextBlock x:Name="DiagnosticsText" Text="No live diagnostics." FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="INSTALLED MEDIA" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <Border Background="White" BorderBrush="#E0E3EA" BorderThickness="1" CornerRadius="9" Padding="11">
                            <StackPanel>
                                <TextBlock x:Name="MediaStateText" Text="Unknown" FontFamily="Segoe UI Semibold" FontSize="14" />
                                <TextBlock x:Name="MediaInformationText" Text="Connect an E12 to read installed media." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="RefreshMediaButton" Content="Read media again" Margin="0,0,7,7" Click="RefreshMedia_Click" IsEnabled="False" />
                                    <Button x:Name="UseInstalledMediaButton" Content="Use installed media" Margin="0,0,7,7" Click="UseLoadedMedia_Click" IsEnabled="False" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PRINT" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                        <Border Background="White" BorderBrush="#E0E3EA" BorderThickness="1" CornerRadius="9" Padding="11">
                            <StackPanel>
                                <TextBlock Text="1-bit output preview" Style="{StaticResource FieldLabel}" Margin="0" />
                                <Border Background="White" BorderBrush="#CDD1D9" BorderThickness="1" Padding="5" MinHeight="72" Margin="0,4,0,0">
                                    <Image x:Name="PrintRasterPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock x:Name="PrintRasterPreviewCaption" Text="Create a label to see its thermal-dot preview." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                                <TextBlock Text="Density" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="DensitySlider" Minimum="0" Maximum="15" Value="7" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DensitySlider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=DensitySlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="ReadinessText" Text="● Label — Create or open a label." TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" />
                                <Button x:Name="PrintButton" Content="Print label" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Print_Click" IsEnabled="False" />
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,20,0,14" Background="#E2E5EB" />
                        <TextBlock Text="SELECTED ELEMENT" Style="{StaticResource SectionTitle}" />
                        <Border x:Name="NoSelectionHint" Background="#F1F2F5" CornerRadius="7" Padding="10">
                            <TextBlock Text="Select an element on the label to edit it." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <StackPanel x:Name="ElementInspector" IsEnabled="False" Visibility="Collapsed">
                            <TextBlock x:Name="ElementKindText" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,3" />
                            <StackPanel x:Name="ContentFieldPanel"><TextBlock Text="Content" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" LostFocus="ElementField_LostFocus" /></StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementXBox" LostFocus="ElementField_LostFocus" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementYBox" LostFocus="ElementField_LostFocus" /></StackPanel></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementWidthBox" LostFocus="ElementField_LostFocus" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementHeightBox" LostFocus="ElementField_LostFocus" /></StackPanel></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rotation (°)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementRotationBox" LostFocus="ElementField_LostFocus" /></StackPanel><StackPanel Grid.Column="2" x:Name="StrokeFieldPanel"><TextBlock Text="Stroke (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementStrokeBox" LostFocus="ElementField_LostFocus" /></StackPanel></Grid>
                            <StackPanel x:Name="FontFieldPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Font size (pt)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementFontSizeBox" LostFocus="ElementField_LostFocus" /></StackPanel><CheckBox x:Name="ElementBoldBox" Grid.Column="2" Content="Bold" VerticalAlignment="Bottom" Margin="0,0,0,7" Checked="ElementBold_Changed" Unchecked="ElementBold_Changed" /></Grid></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#212633">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#E8EAF0" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="DocumentStatusText" Text="No label" Foreground="#AEB4C2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
