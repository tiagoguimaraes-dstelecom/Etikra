<Window x:Class="Etikra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etikra" Height="820" Width="1320" MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#F3F4F7"
        FontFamily="Segoe UI" Foreground="{StaticResource InkBrush}"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E5EB" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="E" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Etikra" FontFamily="Segoe UI Semibold" FontSize="19" />
                        <TextBlock Text="Open label studio" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="New" Margin="0,0,7,0" Click="New_Click" />
                    <Button Content="Open" Margin="0,0,7,0" Click="Open_Click" />
                    <Button Content="Save" Margin="0,0,7,0" Click="Save_Click" />
                    <Button Content="Export PNG" Click="Export_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DuplicateButton" Content="Duplicate" Margin="0,0,8,0" Click="Duplicate_Click" IsEnabled="False" />
                    <Button x:Name="DeleteButton" Content="Delete" Margin="0,0,8,0" Click="Delete_Click" IsEnabled="False" />
                    <Button x:Name="PrintButton" Content="Print label" Style="{StaticResource PrimaryButton}" Click="Print_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFAFC" BorderBrush="#E2E5EB" BorderThickness="0,0,1,0" Padding="16,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ADD TO LABEL" Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource ToolButton}" Content="T   Text" Tag="Text" Click="AddElement_Click" />
                        <Button Style="{StaticResource ToolButton}" Content="▥   Code 128 barcode" Tag="Barcode" Click="AddElement_Click" />
                        <Button Style="{StaticResource ToolButton}" Content="□   Rectangle" Tag="Rectangle" Click="AddElement_Click" />
                        <Button Style="{StaticResource ToolButton}" Content="—   Line" Tag="Line" Click="AddElement_Click" />
                        <Button Style="{StaticResource ToolButton}" Content="▧   Image" Tag="Image" Click="AddElement_Click" />

                        <Separator Margin="0,10,0,14" Background="#E2E5EB" />
                        <TextBlock Text="LABEL" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DocumentNameBox" LostFocus="DocumentField_LostFocus" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DocumentWidthBox" LostFocus="DocumentField_LostFocus" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DocumentHeightBox" LostFocus="DocumentField_LostFocus" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#F0EDFF" CornerRadius="8" Padding="11">
                        <StackPanel>
                            <TextBlock Text="RESEARCH BACKEND" Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI Semibold" FontSize="10" />
                            <TextBlock Text="Verified USB framing plus live-tested E12 Bluetooth discovery, media interrogation, and printing."
                                       TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="#51457F" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#ECEEF2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="48">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="LabelSurface" Background="White" BorderBrush="#CDD1D9" BorderThickness="1"
                                Effect="{DynamicResource LabelShadow}">
                            <Canvas x:Name="DesignCanvas" Background="White" ClipToBounds="True"
                                    MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Background="#FAFAFC" BorderBrush="#E2E5EB" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="PRINT" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Printer" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PrinterCombo" DisplayMemberPath="DisplayName" MinHeight="34" SelectionChanged="PrinterCombo_SelectionChanged" />
                        <Button x:Name="RefreshPrintersButton" Content="Refresh USB + Bluetooth" Margin="0,8,0,0" Click="RefreshPrinters_Click" />
                        <Border Background="#F1F2F5" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PrinterInformationText" Text="Select a printer to see its configuration." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <Button x:Name="UseLoadedMediaButton" Content="Use loaded media size" Margin="0,8,0,0" Click="UseLoadedMedia_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Density" Style="{StaticResource FieldLabel}" Margin="0,13,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
                            <Slider x:Name="DensitySlider" Minimum="0" Maximum="15" Value="7" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=DensitySlider, Path=Value, StringFormat={}{0:0}}" HorizontalAlignment="Right" />
                        </Grid>
                        <Button Content="Print label" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Print_Click" />

                        <Separator Margin="0,20,0,14" Background="#E2E5EB" />
                        <TextBlock Text="SELECTED ELEMENT" Style="{StaticResource SectionTitle}" />
                        <Border x:Name="NoSelectionHint" Background="#F1F2F5" CornerRadius="7" Padding="10">
                            <TextBlock Text="Select an element on the label to edit it." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <StackPanel x:Name="ElementInspector" IsEnabled="False" Visibility="Collapsed">
                            <TextBlock x:Name="ElementKindText" FontFamily="Segoe UI Semibold" FontSize="14" Margin="0,0,0,3" />
                            <StackPanel x:Name="ContentFieldPanel">
                                <TextBlock Text="Content" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ElementContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" LostFocus="ElementField_LostFocus" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="X (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementXBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Y (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementYBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementWidthBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementHeightBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Rotation (°)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementRotationBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                                <StackPanel Grid.Column="2" x:Name="StrokeFieldPanel"><TextBlock Text="Stroke (mm)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementStrokeBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                            </Grid>
                            <StackPanel x:Name="FontFieldPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Font size (pt)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ElementFontSizeBox" LostFocus="ElementField_LostFocus" /></StackPanel>
                                    <CheckBox x:Name="ElementBoldBox" Grid.Column="2" Content="Bold" VerticalAlignment="Bottom" Margin="0,0,0,7" Checked="ElementBold_Changed" Unchecked="ElementBold_Changed" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#212633">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#E8EAF0" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="DocumentStatusText" Text="40 × 30 mm" Foreground="#AEB4C2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
